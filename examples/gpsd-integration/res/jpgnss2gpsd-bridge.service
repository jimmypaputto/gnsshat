[Unit]
Description=Jimmy Paputto GNSS to GPSD Bridge Daemon
Documentation=https://github.com/jimmypaputto/GnssHat
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/jimmypaputto/jpgnss2gpsd-bridge
# Hold the unit in "activating" until the virtual TTY exists, so units ordered
# After= this one (gpsd) do not start before /dev/jimmypaputto/gnss is present.
ExecStartPost=/bin/sh -c 'for _ in $(seq 1 120); do [ -e /dev/jimmypaputto/gnss ] && exit 0; sleep 0.5; done; exit 1'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jpgnss2gpsd-bridge

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/dev /tmp
PrivateDevices=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Resource limits
LimitNOFILE=1024
LimitNPROC=32

[Install]
WantedBy=multi-user.target
